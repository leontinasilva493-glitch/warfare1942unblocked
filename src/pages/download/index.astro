---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VersionTable from '../../components/VersionTable.astro';
import { site } from '../../data/site.mjs';

const title = 'Warfare 1942 Download for PC & Android – Official Links';
const description = 'Use safe Warfare 1942 browser and Android links, identify the official app, and understand why unverified mod APK downloads are risky.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is there an official Warfare 1942 mod APK?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No official or independently verified Warfare 1942 mod APK is provided by this guide. Use the browser build or the verified Google Play listing instead.'
      }
    }
  ]
};
---

<BaseLayout title={title} description={description} path="/download/" schema={schema}>
  <header class="page-hero">
    <div class="shell">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Download', href: '/download/' }]} />
      <span class="eyebrow">Safe deployment</span>
      <h1>Warfare 1942 Download: Official PC and Android Options</h1>
      <p class="page-hero__lede">PC and Mac players can use the browser build without an installer. Android players should verify the developer and package before installing.</p>
    </div>
  </header>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <span class="eyebrow">Platform decision</span>
        <h2>Pick the verified path for your device</h2>
        <p>Use this quick comparison first, then continue to the version and safety details below.</p>
      </div>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Warfare 1942 platform options">
        <table class="version-table">
          <thead>
            <tr>
              <th scope="col">Device</th>
              <th scope="col">Verified option</th>
              <th scope="col">Current status</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Windows &amp; Mac</th>
              <td><a href="/unblocked/">Play in browser</a></td>
              <td>The web edition does not require an EXE, DMG, or desktop launcher from this site.</td>
            </tr>
            <tr>
              <th scope="row">Android</th>
              <td><a href={site.googlePlayUrl} target="_blank" rel="noopener">Google Play</a></td>
              <td>Listing checked <time datetime={site.verifiedIso}>{site.verifiedDate}</time>: Mosaic Games LLC, package <code>com.warfare.ww2.online</code>.</td>
            </tr>
            <tr>
              <th scope="row">iPhone &amp; iPad</th>
              <td>Not independently confirmed</td>
              <td>A matching App Store listing is not independently verified, so no iOS download button is provided.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="shell">
      <div class="section-heading">
        <span class="eyebrow">Version control</span>
        <h2>Compare before you install</h2>
        <p>Matching names do not prove that two listings share a developer, account system, progress, purchases, or promo codes.</p>
      </div>
      <VersionTable />
    </div>
  </section>

  <section class="section">
    <div class="shell prose">
      <span class="eyebrow">Modified download answer</span>
      <h2>Is there an official Warfare 1942 mod APK?</h2>
      <p><strong>No official or independently verified Warfare 1942 mod APK is available from this guide.</strong> “Unlimited money,” “unlocked,” or “menu mod” claims describe third-party modified packages, not the verified Google Play release.</p>
      <p>A modified APK can change the app signature, request unexpected permissions, expose an account, or stop working after an update. For Android, use the <a href={site.googlePlayUrl} target="_blank" rel="noopener">verified Google Play listing</a>. On desktop, use the <a href="/unblocked/">browser version</a> without installing an APK.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell prose">
      <span class="eyebrow">Security check</span>
      <h2>Do not download a random Warfare 1942 APK</h2>
      <p>This site does not host APK, EXE, DMG, mod, or cracked files. A third-party package can be outdated, modified, or signed by a different party even when the title and icon look familiar.</p>
      <ul>
        <li>Open the store listing directly and check the developer name.</li>
        <li>Verify the package ID before installing.</li>
        <li>Review requested permissions and the store's data-safety information.</li>
        <li>Avoid pages that disguise advertisements as download buttons.</li>
      </ul>
      <div class="callout callout--warning"><strong>Legacy Android reference:</strong> <code>com.ww2.shooter.war.games.online</code> is no longer available on Google Play. Archived publisher attribution varies across third-party records, so it is recorded only to prevent version confusion—not as an APK recommendation. <a href={site.legacyAndroidRecordUrl} target="_blank" rel="noopener">View the archived listing record</a>.</div>

      <h2>After the game opens</h2>
      <p>Use the <a href="/how-to-play/">control guide</a> for the web build. Cross-platform progress and accounts have not been independently confirmed, so do not assume a browser session will transfer to Android.</p>
    </div>
  </section>
</BaseLayout>
