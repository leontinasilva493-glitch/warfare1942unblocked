---
import { primaryRoutes } from '../data/site.mjs';
const { currentPath = '/' } = Astro.props;
---

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="Warfare 1942 Guide home">
      <svg class="brand__star" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 2L14.5 8.5L21 9L16 13.5L17.5 20.5L12 16.8L6.5 20.5L8 13.5L3 9L9.5 8.5L12 2Z"></path>
      </svg>
      <span>Warfare 1942</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" data-menu-toggle>
      <span class="menu-toggle__label">Menu</span>
      <span class="menu-toggle__icon" aria-hidden="true"></span>
    </button>
    <nav id="primary-navigation" class="primary-nav" aria-label="Primary navigation" data-primary-nav>
      <a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Home</a>
      {primaryRoutes.slice(0, 3).map((route) => (
        <a href={route.href} aria-current={currentPath === route.href ? 'page' : undefined}>{route.label}</a>
      ))}
    </nav>
    <a class="button button--gold site-header__cta" href="/unblocked/">Play now</a>
  </div>
</header>
