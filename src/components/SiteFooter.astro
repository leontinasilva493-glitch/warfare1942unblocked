---
import { site } from '../data/site.mjs';
---

<footer class="site-footer">
  <div class="shell">
    <div class="site-footer__top">
      <a class="brand brand--small" href="/">
        <svg class="brand__star" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2L14.5 8.5L21 9L16 13.5L17.5 20.5L12 16.8L6.5 20.5L8 13.5L3 9L9.5 8.5L12 2Z"></path>
        </svg>
        <span>Warfare 1942 Guide</span>
      </a>
      <p>Browser play, verified links, and a field guide in one place.</p>
    </div>
    <div class="site-footer__bottom">
      <nav aria-label="Footer navigation">
        <a href="/promo-codes/">Codes</a>
        <a href="/download/">Download</a>
        <a href="/how-to-play/">How to Play</a>
        <a href="/chromebook/">Chromebook</a>
        <a href="/privacy/">Privacy</a>
        <a href="/contact/">Contact</a>
      </nav>
      <p>© 2026 {site.name}. Independent fan-made resource; not affiliated with the game's developers or distribution platforms.</p>
    </div>
  </div>
</footer>
